# --- Local development (Docker Compose behind Nginx) ---
# Nginx serves the API under /api, so the default path is correct.
NEXT_PUBLIC_API_BASE=/api

# Where the Next.js dev server proxies /api/* when you run `npm run dev`
# without the full Docker stack.
API_PROXY_TARGET=http://localhost:8000

# --- Hosted (Vercel) ---
# Set NEXT_PUBLIC_API_BASE to the absolute Render API URL instead, e.g.
#   NEXT_PUBLIC_API_BASE=https://wallet-api.onrender.com
# Requests then go straight to Render and the dev proxy is disabled.
