# --- Local development (Docker Compose behind Nginx) ---
# Leave NEXT_PUBLIC_API_URL unset: the client falls back to the relative "/api",
# which Nginx (or the `npm run dev` proxy) routes to the FastAPI backend.

# Where `npm run dev` proxies /api/* when you run the frontend without the
# full Docker stack.
API_PROXY_TARGET=http://localhost:8000

# --- Hosted (Vercel) ---
# Point at the absolute Render API URL. Requests then go straight to Render.
#   NEXT_PUBLIC_API_URL=https://wallet-api.onrender.com
