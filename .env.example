# Backend (FastAPI + Celery) environment variables.
# Copy to .env for local use, or set these in the Render dashboard when hosting.
# Docker Compose supplies its own values in docker-compose.yml.

# --- Database (Neon.tech or Supabase) ---
# Paste the provider's connection string as-is. The plain `postgresql://`
# scheme is upgraded to the async driver automatically. Keep `?sslmode=require`.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/wallet_db?sslmode=require

# --- Redis broker (Upstash) ---
# Upstash gives a TLS URL. Celery TLS is configured automatically for rediss://.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# --- CORS: the deployed frontend origin (Vercel) ---
FRONTEND_URL=https://your-app.vercel.app
# Optional: override the default Vercel preview-deploy allow regex.
# FRONTEND_URL_REGEX=https://.*\.vercel\.app

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=30
